# ============================================================
# KING ZARRY AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.
# ============================================================

# --- Bot Tokens ---
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# --- AI Providers (at least one required) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Database (Neon PostgreSQL for web frontend) ---
DATABASE_URL=postgresql://user:password@host/dbname

# --- Market Data ---
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
EODHD_API_KEY=

# --- News ---
NEWS_API_KEY=
TAVILY_API_KEY=
NEWSDATA_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=King Zarry AI <onboarding@resend.dev>

# --- Stripe (web billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Admin ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# --- Frontend URL (for CORS + Stripe redirect URLs) ---
FRONTEND_URL=https://your-app.vercel.app

# --- CORS (optional: tighten the Vercel regex for production) ---
# CORS_ALLOW_ORIGIN_REGEX=https://your-app.*\.vercel\.app

# --- Voice (ElevenLabs) ---
ELEVENLABS_API_KEY=

# --- Email Verification ---
REQUIRE_EMAIL_VERIFY=true

# --- Session ---
WEB_SESSION_DAYS=30
