# KING ZARRY AI frontend environment variables
# Local development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Production (Railway):
# NEXT_PUBLIC_API_BASE_URL=https://your-api.up.railway.app

# Stripe publishable key is optional for Checkout redirect flow (session created on API)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Your admin login email(s) — shows Admin nav + allows /admin UI
# NEXT_PUBLIC_ADMIN_EMAILS=you@example.com

# Telegram bot (optional secondary VIP path)
# NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/YourBotUsername
