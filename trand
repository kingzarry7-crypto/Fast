# KITTY — STEP 3: FEATURE ENGINEERING + COST-AWARE LABELS
# Experimental dataset only. No training, no broker connection, no model overwrite.

import numpy as np
import pandas as pd

assert "df_clean" in globals(), "Run the data-cleaning cell first."

HORIZON = 6
MOVE_THRESHOLD = 0.003  # Illustrative 0.30%; calibrate to actual trading costs later.

data = df_clean.copy().sort_index()
parts = []

def make_features(g):
    g = g.copy()

    close = g["Close"].astype(float)
    high = g["High"].astype(float)
    low = g["Low"].astype(float)
    open_ = g["Open"].astype(float)

    # Returns and momentum
    g["ret_1h"] = close.pct_change(1)
    g["ret_3h"] = close.pct_change(3)
    g["ret_6h"] = close.pct_change(6)
    g["ret_12h"] = close.pct_change(12)
    g["ret_24h"] = close.pct_change(24)

    # Trend distances
    sma_6 = close.rolling(6, min_periods=6).mean()
    sma_20 = close.rolling(20, min_periods=20).mean()
    sma_50 = close.rolling(50, min_periods=50).mean()

    g["close_vs_sma6"] = close / sma_6 - 1
    g["close_vs_sma20"] = close / sma_20 - 1
    g["close_vs_sma50"] = close / sma_50 - 1
    g["sma6_vs_sma20"] = sma_6 / sma_20 - 1

    # RSI using rolling average gains/losses
    delta = close.diff()
    gain = delta.clip(lower=0).rolling(14, min_periods=14).mean()
    loss = (-delta.clip(upper=0)).rolling(14, min_periods=14).mean()
    rs = gain / loss.replace(0, np.nan)
    g["rsi_14"] = (100 - 100 / (1 + rs)) / 100

    # MACD, normalised by price
    ema12 = close.ewm(span=12, adjust=False, min_periods=12).mean()
    ema26 = close.ewm(span=26, adjust=False, min_periods=26).mean()
    macd = ema12 - ema26
    signal = macd.ewm(span=9, adjust=False, min_periods=9).mean()
    g["macd_norm"] = macd / close
    g["macd_signal_norm"] = signal / close
    g["macd_hist_norm"] = (macd - signal) / close

    # Volatility and candle shape
    g["volatility_6h"] = g["ret_1h"].rolling(6, min_periods=6).std()
    g["volatility_24h"] = g["ret_1h"].rolling(24, min_periods=24).std()
    g["range_pct"] = (high - low) / close
    g["body_pct"] = (close - open_) / open_.replace(0, np.nan)
    g["close_position"] = (
        (close - low) / (high - low).replace(0, np.nan)
    )

    # Future return is used ONLY to create the label, never as a feature.
    future_close = close.shift(-HORIZON)
    g["future_return_6h"] = future_close / close - 1

    g["target"] = 1  # Default: no-trade zone
    g.loc[g["future_return_6h"] > MOVE_THRESHOLD, "target"] = 2
    g.loc[g["future_return_6h"] < -MOVE_THRESHOLD, "target"] = 0

    return g

for segment_id, group in data.groupby("segment", sort=True):
    parts.append(make_features(group))

featured = pd.concat(parts).sort_index()

feature_cols = [
    "ret_1h", "ret_3h", "ret_6h", "ret_12h", "ret_24h",
    "close_vs_sma6", "close_vs_sma20", "close_vs_sma50",
    "sma6_vs_sma20", "rsi_14",
    "macd_norm", "macd_signal_norm", "macd_hist_norm",
