# KITTY BTC V2 — VALIDATION CONFIDENCE FILTER EXPERIMENT
# Validation only. Do NOT use X_test or y_test here.

import numpy as np
import pandas as pd

assert "val_probs" in globals() and "val" in globals() and "df_clean" in globals(), (
    "Missing validation variables. Check that the Kitty V2 training cells ran."
)

bars = df_clean.sort_index().copy()
validation = val.sort_index().copy()
probs = np.asarray(val_probs)

assert len(probs) == len(validation), "Prediction/validation lengths do not match."

validation["predicted_class"] = probs.argmax(axis=1)
validation["confidence"] = probs.max(axis=1)
validation["signal"] = validation["predicted_class"].map({0: -1, 1: 0, 2: 1})

bar_index = bars.index
results = []
ROUND_TRIP_COST = 0.002  # Assumed 0.20%; test sensitivity separately

for threshold in [0.34, 0.36, 0.38, 0.40, 0.42, 0.44, 0.46]:
    trades = []
    next_allowed_pos = -1
    rejected_gaps = 0

    for timestamp, row in validation.iterrows():
        if row["signal"] == 0 or row["confidence"] < threshold:
            continue

        pos = bar_index.get_indexer([timestamp])[0]
        if pos < 0 or pos < next_allowed_pos:
            continue

        entry_pos, exit_pos = pos + 1, pos + 7
        if exit_pos >= len(bars):
            continue

        window = bars.iloc[pos:exit_pos + 1]
        hourly = (
            len(window) == 8
            and (window.index.to_series().diff().dropna()
                 == pd.Timedelta(hours=1)).all()
            and window["segment"].nunique() == 1
        )

        if not hourly:
            rejected_gaps += 1
            continue

        entry = float(bars.iloc[entry_pos]["Open"])
        exit_price = float(bars.iloc[exit_pos]["Close"])

        if not np.isfinite(entry) or not np.isfinite(exit_price):
            continue
        if entry <= 0 or exit_price <= 0:
            continue

        signal = int(row["signal"])
        gross = signal * (exit_price / entry - 1)
        net = gross - ROUND_TRIP_COST

        trades.append({
            "signal": signal,
            "gross": gross,
            "net": net,
            "confidence": float(row["confidence"])
        })
        next_allowed_pos = exit_pos

    if not trades:
        results.append({
            "confidence_threshold": threshold,
            "trades": 0,
            "win_rate_net": np.nan,
            "mean_net_pct": np.nan,
            "compounded_return_pct": np.nan,
            "max_drawdown_pct": np.nan,
            "long_trades": 0,
            "short_trades": 0,
            "rejected_gaps": rejected_gaps
        })
        continue

    t = pd.DataFrame(trades)
    equity = (1 + t["net"]).cumprod()
    drawdown = equity / equity.cummax() - 1

    results.append({
        "confidence_threshold": threshold,
        "trades": len(t),
        "win_rate_net": (t["net"] > 0).mean() * 100,
        "mean_net_pct": t["net"].mean() * 100,
        "compounded_return_pct": (equity.iloc[-1] - 1) * 100,
        "max_drawdown_pct": drawdown.min() * 100,
        "long_trades": int((t["signal"] == 1).sum()),
        "short_trades": int((t["signal"] == -1).sum()),
        "rejected_gaps": rejected_gaps
    })

confidence_results = pd.DataFrame(results)
print("VALIDATION ONLY — assumed 0.20% round-trip cost")
display(confidence_results.round(3))



