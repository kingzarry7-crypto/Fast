    exit_price_matches.append(
        np.isclose(actual_exit, float(row.exit_close_6h_after_entry),
                   rtol=1e-6, atol=1e-5)
    )

    calculated_return = actual_exit / actual_entry - 1.0
    return_matches.append(
        np.isclose(calculated_return, float(row.target_return),
                   rtol=1e-5, atol=1e-7)
    )

