def evaluate_trades(trade_df, cost_per_trade):
    if len(trade_df) == 0:
        return None

    net_returns = trade_df["gross_return"].to_numpy() - cost_per_trade
    equity = np.cumprod(1.0 + net_returns)
    peak = np.maximum.accumulate(np.concatenate(([1.0], equity)))[1:]
    drawdown = equity / peak - 1.0

