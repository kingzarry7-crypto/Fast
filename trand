# Non-overlapping validation trades by volatility regime
# Diagnostic only: do not use for live trading.

import numpy as np
import pandas as pd

audit = val_v3.sort_index().copy()
audit["prediction"] = np.asarray(val_pred)
audit["confidence"] = np.asarray(val_conf)

# Assign each validation observation to a volatility tercile.
# This is exploratory; do not treat these cutoffs as deployable rules.
audit["regime"] = pd.qcut(
    audit["volatility_24h"].rank(method="first"),
    q=3,
    labels=["Low", "Medium", "High"]
)

# Directional gross return: long, short, or no trade.
audit["gross_return"] = np.where(
    audit["prediction"] == 2,
    audit["target_return"],
    np.where(
        audit["prediction"] == 0,
        -audit["target_return"],
        np.nan
    )
)

# Use the actual entry/exit times if present.
# A new trade is allowed only after the previous trade exits.
results = []

for regime_name in ["Low", "Medium", "High"]:
    subset = audit[
        (audit["regime"] == regime_name)
        & audit["prediction"].isin([0, 2])
    ].copy()

    subset = subset.sort_index()
    selected = []
    last_exit = None

    for timestamp, row in subset.iterrows():
        entry_time = row["entry_time"]
        exit_time = row["exit_time"]

        if last_exit is None or entry_time >= last_exit:
            selected.append({
                "entry_time": entry_time,
                "exit_time": exit_time,
                "gross_return": float(row["gross_return"])
            })
            last_exit = exit_time

    trades = pd.DataFrame(selected)

    for cost_pct in [0.10, 0.20, 0.30]:
        if trades.empty:
            net = pd.Series(dtype=float)
        else:
            net = trades["gross_return"] - cost_pct / 100

        equity = (1 + net).cumprod() if len(net) else pd.Series(dtype=float)

        if len(equity):
            drawdown = equity / equity.cummax() - 1
            compounded_pct = (equity.iloc[-1] - 1) * 100
            max_dd_pct = drawdown.min() * 100
            mean_net_pct = net.mean() * 100
            win_pct = (net > 0).mean() * 100
        else:
            compounded_pct = max_dd_pct = mean_net_pct = win_pct = np.nan

        results.append({
            "regime": regime_name,
            "cost_pct_per_trade": cost_pct,
            "trades": len(trades),
            "mean_net_return_pct": mean_net_pct,
            "net_win_rate_pct": win_pct,
            "compounded_return_pct": compounded_pct,
            "max_drawdown_pct": max_dd_pct
        })

display(pd.DataFrame(results).round(4))

print("Validation-only diagnostic; costs are assumed per trade.")
print("Signals are non-overlapping within each regime, not across regimes.")
print("Regime labels are exploratory and not deployable thresholds.")
