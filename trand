    "Entry equals next candle open time": entry_matches_next_candle,
    "Exit equals entry + six hours": exit_matches_six_hours_later,
    "Signal-to-exit window has hourly candles": continuous_window,
    "Window stays within one segment": same_segment,
    "Stored entry price matches candle open": entry_price_matches,
