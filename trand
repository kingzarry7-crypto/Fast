import copy
import random
import numpy as np
import pandas as pd
import torch
from torch import nn
from torch.utils.data import DataLoader, TensorDataset
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import (
    accuracy_score,
    balanced_accuracy_score,
    roc_auc_score,
    brier_score_loss,
    confusion_matrix
)

# Reproducibility
SEED = 42
random.seed(SEED)
np.random.seed(SEED)
torch.manual_seed(SEED)

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print("Training device:", device)

# Purge the final row of train and validation so next-hour labels
# cannot cross dataset boundaries.
train = train_df.iloc[:-1].copy()
val = val_df.iloc[:-1].copy()
test = test_df.copy()

# Ensure all datasets contain finite numbers.
for name, frame in [("train", train), ("validation", val), ("test", test)]:
    assert np.isfinite(frame[FEATURES].to_numpy(dtype=np.float64)).all(), (
        f"Non-finite features in {name}"
    )
    assert frame["target"].isin([0.0, 1.0]).all(), (
        f"Invalid target in {name}"
    )

# Fit scaler ONLY on training data.
scaler = StandardScaler()
X_train = scaler.fit_transform(train[FEATURES]).astype(np.float32)
X_val = scaler.transform(val[FEATURES]).astype(np.float32)
X_test = scaler.transform(test[FEATURES]).astype(np.float32)

y_train = train["target"].to_numpy(dtype=np.float32)
y_val = val["target"].to_numpy(dtype=np.float32)
y_test = test["target"].to_numpy(dtype=np.float32)

def make_loader(X, y, batch_size=256, shuffle=False):
    ds = TensorDataset(torch.from_numpy(X), torch.from_numpy(y))
    return DataLoader(ds, batch_size=batch_size, shuffle=shuffle)

train_loader = make_loader(X_train, y_train, shuffle=True)
val_loader = make_loader(X_val, y_val)

# Hourly checkpoint: 6 -> 32 -> 16 -> 1.
# Output is a LOGIT; sigmoid converts it to a probability.
class KittyHourlyBTC(nn.Module):
    def __init__(self):
        super().__init__()
        self.network = nn.Sequential(
            nn.Linear(6, 32),
            nn.ReLU(),
            nn.Dropout(0.10),
            nn.Linear(32, 16),
            nn.ReLU(),
            nn.Dropout(0.10),
            nn.Linear(16, 1)
        )

    def forward(self, x):
        return self.network(x).squeeze(-1)

model = KittyHourlyBTC().to(device)
criterion = nn.BCEWithLogitsLoss()
optimizer = torch.optim.Adam(model.parameters(), lr=0.001)

def evaluate_loss(loader):
    model.eval()
    losses = []
    with torch.no_grad():
        for xb, yb in loader:
            xb, yb = xb.to(device), yb.to(device)
            logits = model(xb)
            losses.append(criterion(logits, yb).item() * len(yb))
    return sum(losses) / len(loader.dataset)

# Early stopping uses validation loss, never test performance.
best_val_loss = float("inf")
best_state = None
best_epoch = 0
patience = 12
epochs_without_improvement = 0
MAX_EPOCHS = 100

for epoch in range(1, MAX_EPOCHS + 1):
    model.train()
    running_loss = 0.0

    for xb, yb in train_loader:
        xb, yb = xb.to(device), yb.to(device)

        optimizer.zero_grad()
        logits = model(xb)
        loss = criterion(logits, yb)
        loss.backward()
        optimizer.step()

        running_loss += loss.item() * len(yb)

    train_loss = running_loss / len(train_loader.dataset)
    val_loss = evaluate_loss(val_loader)

    if val_loss < best_val_loss:
        best_val_loss = val_loss
        best_state = copy.deepcopy(model.state_dict())
        best_epoch = epoch
        epochs_without_improvement = 0
    else:
        epochs_without_improvement += 1

    if epoch == 1 or epoch % 5 == 0:
        print(
            f"Epoch {epoch:03d} | "
            f"train loss {train_loss:.5f} | "
            f"validation loss {val_loss:.5f}"
        )

    if epochs_without_improvement >= patience:
        print("Early stopping triggered.")
        break

model.load_state_dict(best_state)
print("\nBest epoch:", best_epoch)
print("Best validation loss:", round(best_val_loss, 5))

# Final test evaluation — performed once after model selection.
model.eval()
with torch.no_grad():
    test_logits = model(torch.from_numpy(X_test).to(device))
    test_probs = torch.sigmoid(test_logits).cpu().numpy()

test_preds = (test_probs >= 0.5).astype(int)
majority_class = int(y_train.mean() >= 0.5)
baseline_preds = np.full(len(y_test), majority_class)

print("\n========== UNSEEN TEST RESULTS ==========")
print("Test examples:", len(y_test))
print("Model accuracy:", round(accuracy_score(y_test, test_preds), 4))
print(
    "Model balanced accuracy:",
    round(balanced_accuracy_score(y_test, test_preds), 4)
)
print("Model ROC-AUC:", round(roc_auc_score(y_test, test_probs), 4))
print("Model Brier score:", round(brier_score_loss(y_test, test_probs), 4))
print("Confusion matrix [[TN, FP], [FN, TP]]:")
print(confusion_matrix(y_test, test_preds))
print(
    "Majority-class baseline accuracy:",
    round(accuracy_score(y_test, baseline_preds), 4)
)
print(
    "Test target up rate:",
    round(float(y_test.mean()), 4)
)

# Save as a NEW hourly checkpoint, not as a replacement for Kitty V3.
torch.save(
    {
        "model_state_dict": model.state_dict(),
        "architecture": [6, 32, 16, 1],
        "features": FEATURES,
        "prediction_horizon": "next_hour",
        "output_type": "logit",
        "seed": SEED,
        "best_epoch": best_epoch
    },
    "kitty_btc_hourly.pt"
)
import joblib
joblib.dump(scaler, "kitty_btc_hourly_scaler.joblib")

