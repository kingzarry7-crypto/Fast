)

signal_before_entry = []
entry_matches_next_candle = []
exit_matches_six_hours_later = []
continuous_window = []
same_segment = []
entry_price_matches = []
exit_price_matches = []
return_matches = []

for timestamp, row, pos in zip(v.index, v.itertuples(), positions):
    # Expected entry is the next candle.
    entry_pos = pos + 1
    exit_pos = pos + 7  # entry candle + six hours

    enough_bars = exit_pos < len(bars)

    signal_before_entry.append(
        pd.Timestamp(timestamp) < pd.Timestamp(row.entry_time)
    )

    if not enough_bars:
        entry_matches_next_candle.append(False)
        exit_matches_six_hours_later.append(False)
        continuous_window.append(False)
        same_segment.append(False)
        entry_price_matches.append(False)
        exit_price_matches.append(False)
        return_matches.append(False)
        continue

    expected_entry_time = bars.index[entry_pos]
    expected_exit_time = bars.index[exit_pos]

    entry_matches_next_candle.append(
        pd.Timestamp(row.entry_time) == expected_entry_time
    )
    exit_matches_six_hours_later.append(
        pd.Timestamp(row.exit_time) == expected_exit_time
    )

    window = bars.iloc[pos:exit_pos + 1]
    diffs = window.index.to_series().diff().dropna()

    continuous_window.append(
        len(window) == 8
        and (diffs == pd.Timedelta(hours=1)).all()
    )

    same_segment.append(
        window["segment"].nunique() == 1
    )

    actual_entry = float(bars.iloc[entry_pos]["Open"])
    actual_exit = float(bars.iloc[exit_pos]["Close"])

